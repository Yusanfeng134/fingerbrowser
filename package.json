{
  "name": "fingerbrowser",
  "version": "0.1.0",
  "description": "企业指纹浏览器 MVP：本地加密配置、独立 Chromium 环境和基础审计。",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "dev:kernel": "node scripts/dev-with-local-kernel.mjs",
    "build": "electron-vite build",
    "website:dev": "vite --config website/vite.config.ts --host 127.0.0.1",
    "website:build": "vite build --config website/vite.config.ts",
    "website:preview": "vite preview --config website/vite.config.ts --host 127.0.0.1",
    "cloud-api:build": "tsc --noEmit -p tsconfig.json",
    "cloud-api:test": "npm run test -- tests/cloud-api.test.ts",
    "mcp": "node out/main/mcp.js",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native": "npm run rebuild:electron",
    "postinstall": "npm rebuild better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run rebuild:node && vitest run",
    "e2e": "npm run build && npm run rebuild:electron && playwright test",
    "package:mac": "npm run build && npm run rebuild:electron && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac --dir",
    "package:linux": "npm run build && npm run rebuild:electron && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux AppImage tar.gz --x64 --config.directories.output=release/linux-x64",
    "license:issue": "node scripts/issue-license.mjs",
    "release:trial": "node scripts/prepare-trial-release.mjs",
    "release:linux:trial": "node scripts/prepare-linux-trial-release.mjs",
    "release:trial:publish": "node scripts/prepare-trial-release.mjs --publish",
    "admin:reset": "node scripts/reset-admin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@puppeteer/browsers": "^2.13.0",
    "better-sqlite3": "^12.9.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "com.fingerbrowser.desktop",
    "productName": "指纹浏览器",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "linux": {
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "fingerbrowser-v${version}-linux-${arch}.${ext}"
    }
  }
}
